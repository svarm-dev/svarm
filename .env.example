# Svärm environment — copy to .env and fill in your keys
# mise auto-loads .env via mise.toml [env]._.file = ".env"

# Required for Docker/prod. Generate without Elixir:
#   openssl rand -base64 48
# Or with Elixir: mix phx.gen.secret
SECRET_KEY_BASE=CHANGEME_openssl_rand_base64_48

# Required for /approvals + board mutations in Docker/prod (HTTP Basic Auth).
# Use a strong unique pair — do not ship shared demo passwords on a real host.
# Demo compose profile may still default to svarm/svarm for zero-key Path A only.
APPROVALS_USER=
APPROVALS_PASSWORD=

# Required for GitHub tracker (PAT mode — auth: token)
GITHUB_TOKEN=ghp_...

# Optional: GitHub App identity (auth: app) — comments/PRs as svarm[bot]
# See docs/github-app.md for setup
# SVARM_GITHUB_APP_ID=
# SVARM_GITHUB_INSTALLATION_ID=
# SVARM_GITHUB_APP_KEY_PATH=/path/to/svarm-app.pem
# # or PEM contents (Docker secrets):
# # SVARM_GITHUB_APP_PRIVATE_KEY=

# Required for agent LLM access (pi + OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: enables "Full run log" link in cost receipt comments
SVARM_BASE_URL=http://localhost:4000

# Optional: zero-key demo (compose --profile demo sets both)
# SVARM_SEED_DEMO=1      # boot-seed when board empty
# SVARM_DEMO_ROUTES=1    # Seed demo button (not implied by SEED)

# Optional: public hostname for URL generation + LiveView origin checks (default: example.com in prod)
# Must match the host browsers use (behind a reverse proxy, the public name — not the container).
# PHX_HOST=svarm.example.com

# Optional: comma-separated origin allow-list when multiple hosts are needed
# (hosts or full origins). Default is //PHX_HOST only.
# PHX_CHECK_ORIGIN=svarm.example.com,//www.example.com

# Session Secure cookie (prod default: true; compose app leaves unset).
# Set false only for plain-HTTP local Docker `--profile app`.
# Demo compose injects false for Path A; production behind HTTPS should leave true/unset.
# PHX_SECURE_COOKIES=false

# Optional: external port (default: 4000)
# SVARM_PORT=4000
